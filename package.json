{
  "name": "bolshaya-medveditsa-crm",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "set NODE_ENV=production&& tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:server": "tsup",
    "build:electron": "tsup --config tsup.electron.config.ts",
    "prepare:packaged-defaults": "node scripts/preparePackagedDefaults.mjs",
    "electron:dev": "npm run build && npm run build:server && npm run build:electron && electron .",
    "electron:start": "electron .",
    "electron:pack": "npm run prepare:packaged-defaults && npm run build && npm run build:server && npm run build:electron && electron-builder --dir",
    "electron:installer": "npm run prepare:packaged-defaults && npm run build && npm run build:server && npm run build:electron && electron-builder --win nsis",
    "electron:installer:win": "set ELECTRON_CACHE=D:\\Temp\\electron-cache&& npm run electron:installer",
    "rebuild:dev": "npm rebuild better-sqlite3",
    "test:audit-fixes": "node scripts/checkEncoding.mjs && tsx scripts/auditFixesTest.ts",
    "test:legacy-import-analysis": "tsx scripts/legacyImportAnalysisTest.ts",
    "test:legacy-import-plan": "tsx scripts/legacyImportPlanTest.ts && tsx scripts/legacyImportApplyTest.ts",
    "test:performance-paging": "tsx scripts/performancePagingTest.ts",
    "test:notification-alerts": "tsx scripts/notificationAlertsTest.ts",
    "import:legacy:analyze": "tsx scripts/legacyImportAnalysis.ts",
    "import:legacy:plan": "tsx scripts/legacyImportPlan.ts",
    "import:legacy": "tsx scripts/legacyImportApply.ts",
    "test:local-api": "node scripts/localApiSmokeTest.mjs",
    "check:encoding": "node scripts/checkEncoding.mjs",
    "smtp:check": "node scripts/smtpDiagnostics.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@pdfme/common": "^6.0.6",
    "@pdfme/generator": "^6.0.6",
    "@pdfme/schemas": "^6.0.6",
    "@pdfme/ui": "^6.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.68.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "libreoffice-convert": "^1.8.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^8.0.4",
    "number-to-words-ru": "^2.4.1",
    "petrovich": "^0.2.1",
    "pizzip": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.5"
  }
}
